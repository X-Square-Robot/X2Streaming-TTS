diff --git a/engine/core/extensions.py b/engine/core/extensions.py
new file mode 100644
index 0000000..6d07f99
--- /dev/null
+++ b/engine/core/extensions.py
@@ -0,0 +1,28 @@
+"""Optional lifecycle extension factories for external engine policies.
+
+This module contains contracts only. Qwen3TTS-Streaming does not import or
+depend on any external extension implementation.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable, Optional
+
+
+PolicyFactory = Callable[[str, Any], Any]
+
+
+@dataclass(frozen=True)
+class EngineExtensions:
+    """Factories for session-scoped optional policies.
+
+    Factories receive ``(session_id, session_config)`` and return an opaque
+    policy owned by the corresponding frontend/backend session. Lifecycle
+    call sites are added independently, keeping this contract method-agnostic.
+    """
+
+    name: str = ""
+    version: str = ""
+    commitment_factory: Optional[PolicyFactory] = None
+    continuity_factory: Optional[PolicyFactory] = None
