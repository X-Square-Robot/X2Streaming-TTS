diff --git a/engine/core/extensions.py b/engine/core/extensions.py
index 6d07f99..1be8e37 100644
--- a/engine/core/extensions.py
+++ b/engine/core/extensions.py
@@ -6,10 +6,14 @@ depend on any external extension implementation.
 
 from __future__ import annotations
 
+import logging
 from dataclasses import dataclass
 from typing import Any, Callable, Optional
 
 
+logger = logging.getLogger(__name__)
+
+
 PolicyFactory = Callable[[str, Any], Any]
 
 
@@ -26,3 +30,73 @@ class EngineExtensions:
     version: str = ""
     commitment_factory: Optional[PolicyFactory] = None
     continuity_factory: Optional[PolicyFactory] = None
+
+
+@dataclass(frozen=True)
+class C2WContinuationState:
+    """Engine-owned immutable view of a finalized Code2Wav state bundle."""
+
+    c2w_kv: Any
+    c2w_conv_states: tuple[Any, ...]
+    c2w_transconv_states: tuple[Any, ...]
+    frame_idx: int
+
+
+def capture_c2w_state(slot: Any, kv_pool: Any = None) -> Optional[C2WContinuationState]:
+    """Deep-copy a complete C2W bundle without exposing a mutable engine slot."""
+
+    try:
+        if getattr(slot, "c2w_kv", None) is not None:
+            kv = slot.c2w_kv.detach().clone()
+        elif getattr(slot, "c2w_pooled", False) and kv_pool is not None:
+            kv = kv_pool.read_c2w_right_aligned(
+                slot.slot_id, int(getattr(slot, "c2w_len", 0))
+            )
+        else:
+            return None
+        conv = tuple(
+            item.detach().clone()
+            for item in (getattr(slot, "c2w_conv_states", None) or ())
+        )
+        transconv = tuple(
+            item.detach().clone()
+            for item in (getattr(slot, "c2w_transconv_states", None) or ())
+        )
+        if not conv or not transconv:
+            return None
+        return C2WContinuationState(
+            c2w_kv=kv,
+            c2w_conv_states=conv,
+            c2w_transconv_states=transconv,
+            frame_idx=int(getattr(slot, "frame_idx", 0)),
+        )
+    except Exception:
+        logger.exception("Could not capture finalized Code2Wav state")
+        return None
+
+
+def invoke_policy(
+    policy: Any,
+    method: str,
+    *args: Any,
+    default: Any = None,
+    **kwargs: Any,
+) -> Any:
+    """Invoke one optional policy callback and fail closed to ``default``."""
+
+    if policy is None:
+        return default
+    callback = getattr(policy, method, None)
+    if not callable(callback):
+        return default
+    try:
+        return callback(*args, **kwargs)
+    except Exception:
+        logger.exception("External policy callback failed: %s", method)
+        invalidate = getattr(policy, "invalidate", None)
+        if callable(invalidate) and method != "invalidate":
+            try:
+                invalidate(f"callback_failed:{method}")
+            except Exception:
+                logger.exception("External policy invalidation failed")
+        return default
