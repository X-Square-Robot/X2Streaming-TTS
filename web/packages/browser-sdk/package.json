{
  "name": "@xmultimodalinteraction/qwen3tts-browser",
  "version": "0.0.0-dev.0",
  "description": "Framework-neutral OpenAI Realtime browser SDK for Qwen3-TTS",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X-Square-Robot/Qwen3TTS-Streaming.git",
    "directory": "web/packages/browser-sdk"
  },
  "keywords": ["tts", "speech", "realtime", "audio", "qwen"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
